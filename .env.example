OPENAI_API_KEY=your-key-here

# Who may log in: comma-separated user:password pairs. Only these people get access.
AUTH_USERS=owner:change-me,friend:another-password
# Long random string used to sign login cookies (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=replace-with-long-random-string
# Set to 1 once served over HTTPS
COOKIE_SECURE=0
